# All server-only. Sample mode needs none of these.

# Real (paid) ranking runs stay off unless this is exactly "true".
# Keep it false in production until the spending cap and the deployed rate
# limit are verified.
ENABLE_REAL_RUNS=false

# Scoring provider. Use a key from an Anthropic workspace that has a monthly
# spend limit (Console > Settings > Workspaces > <workspace> > Spend limits).
# SCORING_PROVIDER=anthropic
# SCORING_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Rate limiting (Upstash for Redis via the Vercel Marketplace sets these).
# Without them, live ranking refuses every run (fails closed).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
