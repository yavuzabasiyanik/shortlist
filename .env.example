# All server-only. Sample mode needs none of these.

# Real (paid) ranking runs stay off unless this is exactly "true".
# Keep it false until the spending cap and the deployed rate limit are verified.
ENABLE_REAL_RUNS=false

# Which model scores resumes. No provider adapter exists yet, so the API
# answers "scoring_not_configured" even when these are set.
# SCORING_PROVIDER=anthropic   # or: openai
# SCORING_MODEL=
